{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "S3Deployment",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket",
				"s3:GetBucketLocation"
			],
			"Resource": "arn:aws:s3:::gmf-cloud-resume-2026"
		},
		{
			"Sid": "S3ObjectDeployment",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": "arn:aws:s3:::gmf-cloud-resume-2026/*"
		},
		{
			"Sid": "CloudFrontInvalidation",
			"Effect": "Allow",
			"Action": [
				"cloudfront:CreateInvalidation"
			],
			"Resource": "arn:aws:cloudfront::339712868174:distribution/E2O4GNJN0TFRAZ"
		}
	]
}